# Copy to .env and adjust. Docker Compose reads it automatically.

# Ports on your machine: the web interface and the API.
WEB_PORT=8080
PORT=3000

# Worker threads per simulation. Empty = CPU cores - 1.
SIM_WORKERS=

# Largest simulation one request may ask for.
MAX_SPINS=100000000

# fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
