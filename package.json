{
  "name": "slottestyfer",
  "version": "0.1.0",
  "private": true,
  "description": "Slot machine engine and Monte Carlo RTP tester (fictional credits only).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @slottestyfer/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test -c e2e",
    "simulate": "tsc -b && node packages/simulator/dist/cli.js",
    "tune": "tsc -b && node packages/simulator/dist/tune-cli.js",
    "analyze": "tsc -b && node packages/analytics/dist/cli.js",
    "api": "tsc -b && node --disable-warning=ExperimentalWarning packages/api/dist/server.js",
    "web": "npm run dev -w @slottestyfer/web",
    "check": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
