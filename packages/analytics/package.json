{
  "name": "@slottestyfer/analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Data analysis of SlotTestyfer games: percentiles, sessions, losing streaks, drawdowns, comparisons and CSV/JSON export.",
  "type": "module",
